# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/my_accounts?sslmode=require"
# Direct (non-pooled) connection string, used by `prisma migrate`, including the
# `migrate deploy` vercel.json runs on every build. A transaction pooler cannot
# hold the advisory lock migrate takes.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/my_accounts?sslmode=require"
# Local development against the docker-compose database instead:
# DATABASE_URL="postgresql://my_accounts:my_accounts@localhost:5436/my_accounts_dev"
# DATABASE_URL_UNPOOLED="postgresql://my_accounts:my_accounts@localhost:5436/my_accounts_dev"

# The docker-compose database `npm run test:integration` migrates and writes to.
TEST_DATABASE_URL="postgresql://my_accounts:my_accounts@localhost:5436/my_accounts_test"

# The database `npm run test:e2e` migrates, empties and serves from; unset uses this
# docker-compose one. Like TEST_DATABASE_URL, its name must end in _test. The E2E dev
# server runs on E2E_PORT (unset: 3218) with its own env, never this file's DATABASE_URL.
E2E_DATABASE_URL="postgresql://my_accounts:my_accounts@localhost:5436/my_accounts_e2e_test"
E2E_PORT="3218"

# Required. Signs session cookies and the signed authorize query, and encrypts the JWKS
# private key: changing it signs everyone out and orphans the signing key.
# Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# The public origin. The OIDC issuer is this plus /api/auth, so production must set it to the
# origin every client was told. Unset on a deployment, the deployment's own URL is used.
BETTER_AUTH_URL="http://localhost:3000"

# Client ids (from `npm run clients:create`) cached per instance and frozen against edits,
# comma-separated. Consent is decided by each client's skip_consent column, not by this list.
# Unset: every client is read from the database on each request.
TRUSTED_CLIENT_IDS=""

# Unset hides the "Sign in with Google" button. Redirect URI to register with Google:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Unset: `next dev` prints the sign-in code to the console, production refuses to send it.
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# `next dev` only: also append each unsent mail as a JSON line to this file (the E2E specs read it).
DEV_MAIL_OUTBOX=""

LOG_LEVEL="info"

# ─── Cost fences ───
# The counter store behind the daily sign-in mail budget. Unset outside production, mail is not
# metered; unset on production, no sign-in mail is sent. The Vercel Marketplace Upstash
# integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Kill switch: "false" stops every sign-in mail; unset leaves it on.
SIGN_IN_MAIL_ENABLED=""
# Sign-in mails for the whole app per UTC day. Unset uses the default shown.
SIGN_IN_MAIL_GLOBAL_DAILY_LIMIT="300"

# ─── Observability (unset leaves each feature off) ───
# Better Stack HTTP source `my-accounts`; warn and above ship there. Unset: stdout only, and
# production logs `better_stack_logs_not_configured` at boot.
BETTERSTACK_SOURCE_URL=""
BETTERSTACK_SOURCE_TOKEN=""
# Sentry, errors only. Unset: the SDK never initialises, and production logs
# `sentry_errors_not_configured` at boot.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional, build-time only: all three or source maps are not uploaded.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Telegram ops alert on every unhandled 5xx. Both must be set; unset on production, the boot
# logs `telegram_alerts_not_configured`.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
# Product events to the shared PostHog project. Unset sends none; `next dev` never sends.
POSTHOG_PROJECT_KEY=""
